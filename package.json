  "types": "src/types/WinRMTypes.ts",
  "scripts": {
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src/**/*.js test/**/*.js",
    "lint:fix": "eslint src/**/*.js test/**/*.js --fix",
    "build": "tsc",
    "build:watch": "tsc --watch",
    "example": "node examples/basic-usage.js",
